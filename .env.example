# Discord bot token (required).
# Get it from https://discord.com/developers/applications → your app → Bot → Reset Token.
DISCORD_TOKEN=

# Discord user ID of the bot owner (required for commands to work).
# Enable Developer Mode in Discord (Settings → Advanced), then right-click your
# user → Copy User ID. The command gate fails closed while this is unset.
DISCORD_OWNER_ID=

# Guild (server) ID for instant, guild-scoped slash-command registration (optional).
# Right-click your server icon → Copy Server ID. Omit to register commands
# globally instead (global commands can take up to an hour to propagate).
DISCORD_GUILD_ID=

# Channel ID for dedicated chat channel (optional).
# Right-click the channel → Copy Channel ID. If set, bot responds to ALL messages
# in this channel without needing @mentions. Threads in this channel also work.
DISCORD_CHANNEL_ID=

# OpenAI-compatible API base URL (required).
# Set your OpenAI-compatible API endpoint (e.g., https://api.openai.com/v1 or http://localhost:8787/v1).
OPENAI_BASE_URL=

# OpenAI API key (required).
# Set your API key.
OPENAI_API_KEY=

# Model to use (required).
# Set the model to use (e.g., gpt-4o, gpt-4o-mini, or your custom model name).
OPENAI_MODEL=

# Maximum tokens per response (optional).
# OPENAI_MAX_TOKENS=

# Temperature for sampling (optional).
# OPENAI_TEMPERATURE=

# System prompt (optional).
# OPENAI_SYSTEM_PROMPT=

# Rate limit: requests per minute per user (optional, default 30).
# RATE_LIMIT_RPM=30